{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gvid:lint-scenario args",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scenarioId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "要质检的剧本 id；省略则对当前 active 剧本跑 lint"
    }
  }
}
