{
  "schemaVersion": 1,
  "id": "@forgeax-extension/agent-nodia",
  "version": "0.1.0",
  "kind": "agent",
  "displayName": { "zh": "Nodia · 视频游戏导演", "en": "Nodia · Video-Game Director" },
  "description": {
    "zh": "视频游戏（玩法优先）导演：用 @forgeax/wb-game-video 的 11 个工具先搭 GameGraph 蓝图，再导入参考图并生成镜头脚本、关键帧与视频，绑定素材后完成试玩验证。适合视频画面上的 Boss 战、血条、QTE、限时选择和热点交互；纯叙事互动影片归 Reia，实时渲染的 2D/3D 游戏归常规流水线。",
    "en": "Gameplay-first video-game director. Uses all 11 @forgeax/wb-game-video tools to build a GameGraph blueprint, import references, generate shot scripts, keyframes, and videos, bind assets, and verify the playable result. Best for boss battles, HP bars, QTEs, timed choices, and hotspots over video; pure interactive films belong to Reia and real-time 2D/3D games use the regular pipeline."
  },
  "provides": {
    "agent": {
      "id": "nodia",
      "role": "game-video-director",
      "card": {
        "name": { "zh": "Nodia", "en": "Nodia" },
        "cnTitle": "视频游戏导演",
        "enTitle": "Video-Game Director",
        "color": "#8FC9A8",
        "avatar": "🎮"
      },
      "personaFile": "./persona/zh.md",
      "memoryDir": "./memory/",
      "produces": [
        "<active_game>.dir/blueprint.json",
        "<active_game>.dir/project.json",
        "<active_game>.dir/assets/**",
        "<active_game>.dir/**/wb-game-video-shotlist.md",
        "<active_game>.dir/**/qte-pacing.md"
      ],
      "agentTags": ["game-video", "video-game", "gameplay", "玩法优先", "视频游戏", "boss", "qte", "hotspot", "blueprint", "graph"],
      "tools": [
        "wb-game-video:get-graph",
        "wb-game-video:save-graph",
        "wb-game-video:list-videos",
        "wb-game-video:generate-shot-script",
        "wb-game-video:generate-keyframe",
        "wb-game-video:generate-video",
        "wb-game-video:generate-node-video",
        "wb-game-video:list-assets",
        "wb-game-video:get-asset",
        "wb-game-video:import-character-refs",
        "wb-game-video:import-scene-refs",
        "narrative:start-pipeline",
        "narrative:resume-pipeline",
        "narrative:get-run-status",
        "narrative:get-story-tree",
        "narrative:list-runs",
        "narrative:read-file",
        "narrative:list-files",
        "narrative:save-step-edit",
        "narrative:analyze-impact",
        "narrative:regenerate-step"
      ],
      "preferredCliProvider": "forgeax-native",
      "defaultLang": "zh",
      "multiInstance": false
    }
  },
  "experimental": true
}
