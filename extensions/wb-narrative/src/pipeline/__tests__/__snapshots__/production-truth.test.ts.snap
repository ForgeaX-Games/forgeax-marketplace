    }
  ],
  "endings": [
    { "ending_id": "END_B1", "label": "B", "scope": "local", "title": "……", "content": "...", "trigger": "在灵药谷 QTE 失败" },
    { "ending_id": "END_H1", "label": "H", "scope": "global", "title": "黎明之约", "content": "...", "trigger": "在终极抉择中选择 A" }
  ],
  "branch_summary": {
    "pivot_choice_count": 2,
    "pivot_branch_qte_count": 1,
