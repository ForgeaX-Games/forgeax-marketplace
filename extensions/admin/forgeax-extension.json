{
  "schemaVersion": 2,
  "id": "@forgeax-extension/admin",
  "version": "0.1.0",
  "displayName": {
    "zh": "面板管理",
    "en": "Admin"
  },
  "description": {
    "zh": "面板管理工作台 · 四个区:工作台启用 / 排序、多模态模型绑定、cli-provider 认证健康、marketplace 插件计数;与 Studio 设置面板(SettingsPanel)的 sections 同源。",
    "en": "Admin workbench — four sections: workbench enable/order, multi-modal model bindings, cli-provider auth health, and marketplace plugin counts; kept in sync with Studio's SettingsPanel sections."
  },
  "entry": {
    "frontend": "./src/panel.tsx"
  },
  "experimental": true,
  "categories": [
    "workbench"
  ],
  "contributes": {
    "panelTypes": [
      {
        "id": "admin.content",
        "runtime": "inline",
        "entry": "./src/panel.tsx"
      }
    ],
    "pages": [
      {
        "id": "admin",
        "title": {
          "zh": "面板管理",
          "en": "Admin"
        },
        "icon": "⚙",
        "cardinality": "singleton",
        "restorePolicy": "project",
        "layout": {
          "version": 2,
          "root": {
            "kind": "tabs",
            "placements": [
              "content"
            ],
            "active": "content"
          }
        },
        "layoutVersion": 2,
        "panels": [
          {
            "id": "content",
            "panelType": {
              "extension": "self",
              "id": "admin.content"
            }
          }
        ],
        "matchProduces": [
          "**/.forgeax/**",
          "**/marketplace/**"
        ]
      }
    ],
    "activities": [
      {
        "id": "admin.launcher",
        "title": {
          "zh": "面板管理",
          "en": "Admin"
        },
        "icon": "⚙",
        "order": 210,
        "category": "workbench",
        "pageType": {
          "extension": "self",
          "id": "admin"
        }
      }
    ]
  }
}
