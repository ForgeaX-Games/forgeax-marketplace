{
  "schemaVersion": 2,
  "id": "@forgeax-extension/wb-diffusion-renderer",
  "version": "0.1.0",
  "displayName": {
    "zh": "Diffusion Renderer",
    "en": "Diffusion Renderer"
  },
  "description": {
    "zh": "从游戏世界的语义状态、动作、相机与可选视口媒体生成独立表现层画面。支持 FluxRT 与 LingBot World 2，且绝不反向驱动游戏 ECS。",
    "en": "Generates a separate presentation stream from semantic game state, actions, camera state, and optional viewport media. Supports FluxRT and LingBot World 2 without ever driving game ECS."
  },
  "author": {
    "name": "forgeax",
    "email": "dev@forgeax.local"
  },
  "icon": "Aperture",
  "keywords": [
    "diffusion-renderer",
    "realtime",
    "viewport",
    "fluxrt",
    "lingbot"
  ],
  "entry": {
    "frontend": "./index.html",
    "standalone": {
      "start": "false",
      "port": 0,
      "readyProbe": "/",
      "embeddedAlso": true,
      "devOnly": false
    }
  },
  "requestedEnv": [
    "FLUXRT_API_KEY",
    "FLUXRT_BASE_URL",
    "REACTOR_API_KEY",
    "REACTOR_COORDINATOR_URL"
  ],
  "experimental": true,
  "compatibleWith": {
    "forgeax-bus": "^1.0.0"
  },
  "categories": [
    "workbench"
  ],
  "contributes": {
    "panelTypes": [
      {
        "id": "wb-diffusion-renderer.content",
        "runtime": "iframe",
        "entry": "./index.html"
      }
    ],
    "pages": [
      {
        "id": "wb-diffusion-renderer",
        "title": {
          "zh": "Diffusion Renderer",
          "en": "Diffusion Renderer"
        },
        "icon": "Aperture",
        "cardinality": "singleton",
        "restorePolicy": "project",
        "layout": {
          "version": 2,
          "root": {
            "kind": "tabs",
            "placements": [
              "content"
            ],
            "active": "content"
          }
        },
        "layoutVersion": 2,
        "panels": [
          {
            "id": "content",
            "panelType": {
              "extension": "self",
              "id": "wb-diffusion-renderer.content"
            }
          }
        ]
      }
    ],
    "activities": [
      {
        "id": "wb-diffusion-renderer.launcher",
        "title": {
          "zh": "Diffusion Renderer",
          "en": "Diffusion Renderer"
        },
        "icon": "Aperture",
        "order": 160,
        "category": "3D",
        "pageType": {
          "extension": "self",
          "id": "wb-diffusion-renderer"
        }
      }
    ]
  }
}
