{
  "schemaVersion": 1,
  "id": "@forgeax-extension/wb-diffusion-renderer",
  "version": "0.1.0",
  "kind": "workbench",
  "displayName": {
    "zh": "Diffusion Renderer",
    "en": "Diffusion Renderer"
  },
  "description": {
    "zh": "从游戏世界的语义状态、动作、相机与可选视口媒体生成独立表现层画面。支持 FluxRT 与 LingBot World 2，且绝不反向驱动游戏 ECS。",
    "en": "Generates a separate presentation stream from semantic game state, actions, camera state, and optional viewport media. Supports FluxRT and LingBot World 2 without ever driving game ECS."
  },
  "author": {
    "name": "forgeax",
    "email": "dev@forgeax.local"
  },
  "icon": "🎨",
  "keywords": ["diffusion-renderer", "realtime", "viewport", "fluxrt", "lingbot"],
  "provides": {
    "workbench": {
      "id": "wb-diffusion-renderer",
      "icon": "🎨",
      "position": 160,
      "panelSize": "md",
      "surface": "single"
    }
  },
  "entry": {
    "frontend": "./index.html",
    "standalone": {
      "start": "false",
      "port": 0,
      "readyProbe": "/",
      "embeddedAlso": true,
      "devOnly": false
    }
  },
  "requestedEnv": ["FLUXRT_API_KEY", "FLUXRT_BASE_URL", "REACTOR_API_KEY", "REACTOR_COORDINATOR_URL"],
  "experimental": true,
  "compatibleWith": {
    "forgeax-bus": "^1.0.0"
  }
}
