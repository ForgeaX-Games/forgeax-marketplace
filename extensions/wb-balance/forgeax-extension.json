{
  "schemaVersion": 2,
  "id": "@forgeax-extension/wb-balance",
  "version": "0.1.0",
  "displayName": {
    "zh": "平衡 / 数值",
    "en": "Balance & Sim"
  },
  "description": {
    "zh": "平衡 / 数值工作台(规划中)· 目标:调用 balance:resim 跑 N 次重模拟,dashboard 显示胜率 + 95% 置信区间,与玩家手调数值形成闭环。当前为 marketplace 占位,面板实现待后续 sprint 落地。",
    "en": "Balance & sim workbench (planned) — will drive balance:resim for N-trial replays, dashboard win-rate + 95% CI, and loop with manual stat tweaks. Currently a marketplace placeholder; the panel lands in a later sprint."
  },
  "entry": {
    "frontend": "./src/panel.tsx"
  },
  "experimental": true,
  "categories": [
    "workbench"
  ],
  "contributes": {
    "panelTypes": [
      {
        "id": "balance.content",
        "runtime": "inline",
        "entry": "./src/panel.tsx"
      }
    ],
    "pages": [
      {
        "id": "balance",
        "title": {
          "zh": "平衡 / 数值",
          "en": "Balance & Sim"
        },
        "icon": "📐",
        "cardinality": "singleton",
        "restorePolicy": "project",
        "layout": {
          "version": 2,
          "root": {
            "kind": "tabs",
            "placements": [
              "content"
            ],
            "active": "content"
          }
        },
        "layoutVersion": 2,
        "panels": [
          {
            "id": "content",
            "panelType": {
              "extension": "self",
              "id": "balance.content"
            }
          }
        ],
        "matchProduces": [
          "**/balance/**",
          "**/sim/**"
        ]
      }
    ]
  }
}
