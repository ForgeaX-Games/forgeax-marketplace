{
  "schemaVersion": 2,
  "id": "@forgeax-extension/wb-observatory",
  "version": "0.1.0",
  "displayName": {
    "zh": "Observatory · 轨迹观察台",
    "en": "Observatory"
  },
  "description": {
    "zh": "Observatory · 轨迹观察台(工作台)· 用 reactflow 把一次 agent 会话画成 session→turn→tool / 子 agent 的图,实时(SSE)+ 离线回放;并把拼好的 system-prompt 切成带 token 估算的模块切片,辅助上下文 / skill / 护栏 / cache 管理。",
    "en": "Observatory workbench — renders an agent session as a reactflow graph (session to turn to tool / sub-agent) with a live SSE tail + offline replay, and slices the composed system prompt into inspectable modules with token estimates; aids context / skill / guardrail / cache management."
  },
  "author": {
    "name": "forgeax",
    "email": "dev@forgeax.local"
  },
  "icon": "🔭",
  "keywords": [
    "observatory",
    "agent",
    "sub-agent",
    "trace",
    "sse",
    "reactflow",
    "context",
    "system-prompt"
  ],
  "entry": {
    "frontend": "./dist/index.html",
    "standalone": {
      "start": "false",
      "port": 0,
      "readyProbe": "/",
      "embeddedAlso": true,
      "devOnly": false
    }
  },
  "permissions": [
    "fs:read:~/.forgeax/sessions/**"
  ],
  "experimental": true,
  "compatibleWith": {
    "forgeax-bus": "^1.0.0"
  },
  "categories": [
    "workbench"
  ],
  "contributes": {
    "panelTypes": [
      {
        "id": "wb-observatory.content",
        "runtime": "iframe",
        "entry": "./dist/index.html"
      }
    ],
    "pages": [
      {
        "id": "wb-observatory",
        "title": {
          "zh": "Observatory · 轨迹观察台",
          "en": "Observatory"
        },
        "icon": "🔭",
        "cardinality": "singleton",
        "restorePolicy": "project",
        "layout": {
          "version": 2,
          "root": {
            "kind": "tabs",
            "placements": [
              "content"
            ],
            "active": "content"
          }
        },
        "layoutVersion": 2,
        "panels": [
          {
            "id": "content",
            "panelType": {
              "extension": "self",
              "id": "wb-observatory.content"
            }
          }
        ]
      }
    ],
    "activities": [
      {
        "id": "wb-observatory.launcher",
        "title": {
          "zh": "Observatory · 轨迹观察台",
          "en": "Observatory"
        },
        "icon": "🔭",
        "order": 150,
        "category": "workbench",
        "pageType": {
          "extension": "self",
          "id": "wb-observatory"
        }
      }
    ]
  }
}
