{
  "id": "g_door_leaf",
  "label": "门扇",
  "name-en": "GDoorLeaf",
  "description": "追加一条 door_leaf(...) shape；供 Geometry DSL 编译器精确执行门扇语句。",
  "description-en": "Append exactly one door_leaf(...) shape for deterministic Geometry DSL execution.",
  "version": "1.0.0",
  "autoIterate": true,
  "tags": ["geometry", "architecture", "door", "leaf", "cad"],
  "tag_labels": ["几何", "建筑", "门", "门扇", "CAD"],
  "principal": "geometry",
  "inputs": [
    { "name": "geometry", "type": "geometry", "required": false, "label": "几何" },
    { "name": "width", "type": "number", "required": true, "label": "门扇宽" },
    { "name": "height", "type": "number", "required": true, "label": "门扇高" },
    { "name": "thickness", "type": "number", "required": true, "label": "门扇厚" },
    { "name": "hinge", "type": "string", "required": false, "label": "铰接边", "default": "center" },
    { "name": "style", "type": "string", "required": false, "label": "样式", "default": "flush" },
    { "name": "panel_rows", "type": "number", "required": false, "label": "嵌板行", "default": 2 },
    { "name": "panel_cols", "type": "number", "required": false, "label": "嵌板列", "default": 1 },
    { "name": "id", "type": "string", "required": false, "label": "id", "default": "" }
  ],
  "outputs": [
    { "name": "geometry", "type": "geometry", "label": "几何" },
    { "name": "id", "type": "string", "label": "id" },
    { "name": "error", "type": "string", "label": "错误" }
  ],
  "projectTypes": ["asset3d"]
}
