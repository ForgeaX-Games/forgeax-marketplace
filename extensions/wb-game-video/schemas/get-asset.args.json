{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gen:get-asset args",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": {
    "gameSlug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$", "description": "Target game slug. Omit to use the active game." },
    "id": { "type": "string", "description": "Asset id to fetch." }
  }
}
