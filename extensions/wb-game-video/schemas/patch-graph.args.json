{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wb-game-video:patch-graph args",
  "type": "object",
  "additionalProperties": false,
  "required": ["ops"],
  "$defs": {
    "nodeIdOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "nodeId"],
      "properties": {
        "op": { "enum": ["remove-node", "ensure-node-overlay", "attach-sub-process"] },
        "nodeId": { "type": "string", "minLength": 1 }
      }
    },
    "overlayChildTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "nodeId", "childId"],
      "properties": {
        "op": { "enum": ["remove-overlay-child", "reset-overlay-override"] },
        "nodeId": { "type": "string", "minLength": 1 },
        "childId": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "blueprintId": { "type": "string", "minLength": 1 },
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "nodeId", "field", "value"],
            "properties": {
              "op": { "const": "set-node-field" },
              "nodeId": { "type": "string", "minLength": 1 },
              "field": { "enum": ["name", "type", "position"] },
              "value": {}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "nodeId", "patch"],
            "properties": {
              "op": { "const": "set-node-data" },
              "nodeId": { "type": "string", "minLength": 1 },
              "patch": { "type": "object" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "node"],
            "properties": {
              "op": { "const": "add-node" },
              "node": { "type": "object" }
            }
          },
          { "$ref": "#/$defs/nodeIdOp" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "afterId"],
            "properties": {
              "op": { "const": "insert-node-after" },
              "afterId": { "type": "string", "minLength": 1 },
              "name": { "type": "string" },
              "gapX": { "type": "number" },
              "node": { "type": "object" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "source", "target"],
            "properties": {
              "op": { "const": "connect" },
              "id": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "target": { "type": "string", "minLength": 1 },
              "sourceHandle": { "type": "string" },
              "targetHandle": { "type": "string" },
              "data": { "type": "object" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "edgeId"],
            "properties": {
              "op": { "const": "disconnect" },
              "edgeId": { "type": "string", "minLength": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "edgeId", "data"],
            "properties": {
              "op": { "const": "update-edge-data" },
              "edgeId": { "type": "string", "minLength": 1 },
              "data": { "type": "object" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "nodeId", "patch"],
            "properties": {
              "op": { "const": "patch-node-bgm" },
              "nodeId": { "type": "string", "minLength": 1 },
              "patch": { "type": "object" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "nodeId", "child"],
            "properties": {
              "op": { "const": "add-overlay-child" },
              "nodeId": { "type": "string", "minLength": 1 },
              "child": { "type": "object" }
            }
          },
          { "$ref": "#/$defs/overlayChildTarget" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "nodeId", "childId", "patch"],
            "properties": {
              "op": { "const": "patch-overlay-child" },
              "nodeId": { "type": "string", "minLength": 1 },
              "childId": { "type": "string", "minLength": 1 },
              "patch": { "type": "object" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "nodeId", "childId", "inputs"],
            "properties": {
              "op": { "const": "patch-overlay-child-params" },
              "nodeId": { "type": "string", "minLength": 1 },
              "childId": { "type": "string", "minLength": 1 },
              "inputs": { "type": "object" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "nodeId", "mountId", "patch"],
            "properties": {
              "op": { "const": "patch-overlay-mount" },
              "nodeId": { "type": "string", "minLength": 1 },
              "mountId": { "type": "string", "minLength": 1 },
              "patch": { "type": "object" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op"],
            "properties": {
              "op": { "const": "make-empty-sub-flow-pack" },
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string" },
              "version": { "type": "string" }
            }
          }
        ]
      }
    }
  }
}
