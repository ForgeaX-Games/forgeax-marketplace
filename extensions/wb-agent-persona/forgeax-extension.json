{
  "schemaVersion": 2,
  "id": "@forgeax-extension/wb-agent-persona",
  "version": "0.1.0",
  "displayName": {
    "zh": "Agent Persona 编辑器",
    "en": "Agent Persona Editor"
  },
  "description": {
    "zh": "Agent Persona 编辑器(工作台)· 列表选 agent → 文本区编辑其 persona/zh.md → 保存即热重载,实时调每个 agent 的人设与行为。",
    "en": "Agent Persona Editor workbench — pick an agent from the list, edit its persona/zh.md in a textarea, and save with hot-reload to tune each agent's persona and behavior live."
  },
  "author": {
    "name": "forgeax",
    "email": "dev@forgeax.local"
  },
  "icon": "UserCog",
  "keywords": [
    "agent",
    "persona",
    "editor",
    "prompt"
  ],
  "entry": {
    "frontend": "./index.html",
    "standalone": {
      "start": "true",
      "port": 0,
      "readyProbe": "/",
      "embeddedAlso": true,
      "devOnly": false
    }
  },
  "permissions": [
    "fs:read:packages/marketplace/extensions/agent-*/persona/**",
    "fs:write:packages/marketplace/extensions/agent-*/persona/**"
  ],
  "hot": false,
  "experimental": true,
  "compatibleWith": {
    "forgeax-bus": "^1.0.0"
  },
  "categories": [
    "workbench"
  ],
  "contributes": {
    "panelTypes": [
      {
        "id": "wb-agent-persona.content",
        "runtime": "iframe",
        "entry": "./index.html"
      }
    ],
    "pages": [
      {
        "id": "wb-agent-persona",
        "title": {
          "zh": "Agent Persona 编辑器",
          "en": "Agent Persona Editor"
        },
        "icon": "UserCog",
        "cardinality": "singleton",
        "restorePolicy": "project",
        "layout": {
          "version": 2,
          "root": {
            "kind": "split",
            "direction": "horizontal",
            "sizes": [
              240,
              840
            ],
            "children": [
              {
                "kind": "tabs",
                "placements": [
                  "sidebar"
                ],
                "active": "sidebar"
              },
              {
                "kind": "tabs",
                "placements": [
                  "workspace"
                ],
                "active": "workspace"
              }
            ]
          }
        },
        "layoutVersion": 2,
        "panels": [
          {
            "id": "sidebar",
            "panelType": {
              "extension": "self",
              "id": "wb-agent-persona.content"
            },
            "initialProps": {
              "pane": "left",
              "width": 240,
              "scrollable": true
            }
          },
          {
            "id": "workspace",
            "panelType": {
              "extension": "self",
              "id": "wb-agent-persona.content"
            },
            "initialProps": {
              "pane": "center",
              "minHeight": 600,
              "scrollable": true
            }
          }
        ]
      }
    ],
    "activities": [
      {
        "id": "wb-agent-persona.launcher",
        "title": {
          "zh": "Agent Persona 编辑器",
          "en": "Agent Persona Editor"
        },
        "icon": "UserCog",
        "order": 200,
        "category": "general",
        "pageType": {
          "extension": "self",
          "id": "wb-agent-persona"
        }
      }
    ]
  }
}
