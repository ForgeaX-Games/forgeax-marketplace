{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forgeax://plugin/wb-bgm/apply-audio-plan.args",
  "title": "apply-audio-plan args",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "description": "目标游戏slug"
    },
    "planId": {
      "type": "string",
      "minLength": 1,
      "description": "resolve-audio-plan返回的planId"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "description": "可直接传入resolve-audio-plan返回的items",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["exact", "fallback", "gap", "error"]
          },
          "familyId": {
            "type": "string"
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "assetId": {
                  "type": "string",
                  "description": "来自Live检索结果"
                },
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "resUrl": {
                  "type": "string",
                  "description": "来自Live检索结果，禁止编造"
                },
                "filename": {
                  "type": "string"
                }
              },
              "required": ["assetId", "resUrl"]
            }
          },
          "selectedFamily": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "familyId": { "type": "string" },
              "variants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "assetId": {
                      "type": "string",
                      "description": "来自Live检索结果"
                    },
                    "name": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "resUrl": {
                      "type": "string",
                      "description": "来自Live检索结果，禁止编造"
                    },
                    "filename": {
                      "type": "string"
                    }
                  },
                  "required": ["assetId", "resUrl"]
                }
              }
            }
          }
        },
        "required": ["eventId"]
      }
    }
  },
  "required": ["slug", "planId", "items"]
}
