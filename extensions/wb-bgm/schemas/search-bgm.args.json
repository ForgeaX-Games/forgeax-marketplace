{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forgeax://plugin/wb-bgm/search-bgm.args",
  "title": "search-bgm args",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "bgm",
      "description": "固定为 bgm"
    },
    "queryText": {
      "type": "string",
      "description": "玩家原始描述或曲目关键词；可与结构化标签同时使用"
    },
    "scene": {
      "type": "string",
      "enum": [
        "menu_lobby",
        "exploration_ambient",
        "combat",
        "boss_combat",
        "narrative_emotion",
        "puzzle_casual",
        "strategy_management",
        "competition",
        "result_event",
        "general_theme"
      ],
      "description": "主要使用场景，核心条件"
    },
    "moodIds": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "calm",
          "tense",
          "dark",
          "mysterious",
          "epic",
          "warm",
          "sad",
          "playful"
        ]
      },
      "description": "情绪，最多两项"
    },
    "energy": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "能量强度"
    },
    "world": {
      "type": "string",
      "enum": [
        "eastern_fantasy",
        "western_fantasy",
        "sci_fi_cyber",
        "historical_culture",
        "modern_urban",
        "post_apocalyptic",
        "neutral_general"
      ],
      "description": "世界观；只有文件名或目录有明确证据时才作为正式标签"
    },
    "topK": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 5,
      "description": "返回曲目数量"
    },
    "dryRun": {
      "type": "boolean",
      "default": false,
      "description": "true时只验证本地目录和排序，不返回可挂载URL"
    }
  },
  "required": ["kind"],
  "anyOf": [
    { "required": ["queryText"] },
    { "required": ["scene"] },
    { "required": ["moodIds"] },
    { "required": ["energy"] },
    { "required": ["world"] }
  ]
}
