{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forgeax://plugin/wb-bgm/resolve-audio-plan.args",
  "title": "resolve-audio-plan args",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Audio Plan协议版本，当前建议audio-plan/1"
    },
    "planId": {
      "type": "string",
      "description": "调用方提供的稳定计划ID；省略时由服务生成"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "description": "项目声音世界配置ID，通常与游戏slug一致"
    },
    "slug": {
      "type": "string",
      "description": "目标游戏slug，原样带入结果供apply-audio-plan使用"
    },
    "topK": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 3,
      "description": "每个事件返回的不同音效族数量"
    },
    "dryRun": {
      "type": "boolean",
      "default": false,
      "description": "true只验证本地索引；结果没有可挂载assetId/resUrl"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "description": "稳定的游戏声音事件ID，如player.heavy_attack.hit"
          },
          "playerGoal": {
            "type": "string",
            "description": "该声音需要向玩家传达的反馈目标"
          },
          "kind": {
            "const": "sfx",
            "description": "当前固定为sfx"
          },
          "cue": {
            "type": "string",
            "minLength": 1,
            "description": "标准事件，如combat.attack.impact"
          },
          "directoryCategory": {
            "type": "string",
            "description": "可选一级目录英文ID，与玩家端共用，如3_combat；明确时作为硬条件"
          },
          "directorySubcategory": {
            "type": "string",
            "description": "可选二级在线目录ID，与玩家端共用，如melee；填写时必须同时填写directoryCategory"
          },
          "source": {
            "type": "string",
            "description": "声源，如sword / creature"
          },
          "targetMaterial": {
            "type": "string",
            "description": "作用材质，如metal / flesh / wood"
          },
          "intensity": {
            "type": "string",
            "description": "力度，如light / medium / heavy"
          },
          "exclude": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true,
            "description": "硬排除项，如voice / music / sci_fi"
          },
          "variantCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8,
            "default": 3,
            "description": "为该事件保留的族内变体数量"
          },
          "topK": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "覆盖全局topK"
          },
          "priority": {
            "type": "string",
            "description": "core / normal / decorative，仅用于计划记录"
          }
        },
        "required": ["eventId", "playerGoal", "cue"]
      }
    }
  },
  "required": ["projectId", "items"]
}
