{
  "type": "object",
  "properties": {
    "slug": { "type": "string", "description": "目标游戏 slug" },
    "projectId": { "type": "string", "description": "音频项目 ID；默认与 slug 相同" },
    "expectedRevision": { "type": "integer", "minimum": 0, "description": "编辑开始时读取到的草稿修订号" },
    "removeEventIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" },
      "description": "从草稿移除的事件 ID"
    },
    "upsertBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string" },
          "label": { "type": "string" },
          "enabled": { "type": "boolean" },
          "kind": { "type": "string", "enum": ["sfx", "music", "voice"] },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "assetId": { "type": "string" },
                "file": { "type": "string", "description": "相对游戏 audio/ 目录的安全路径" },
                "name": { "type": "string" },
                "shaping": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "gainDb": { "type": "number", "minimum": -24, "maximum": 12 },
                    "pitchSemitones": { "type": "number", "minimum": -12, "maximum": 12 },
                    "highpassHz": { "type": "number", "minimum": 20, "maximum": 2000 },
                    "lowpassHz": { "type": "number", "minimum": 1000, "maximum": 20000 },
                    "eqLowDb": { "type": "number", "minimum": -12, "maximum": 12 },
                    "eqMidDb": { "type": "number", "minimum": -12, "maximum": 12 },
                    "eqHighDb": { "type": "number", "minimum": -12, "maximum": 12 }
                  }
                }
              },
              "required": ["assetId", "file"],
              "additionalProperties": false
            }
          },
          "variation": {
            "type": "object",
            "properties": {
              "mode": { "type": "string", "enum": ["single", "sequential", "random-no-repeat"] }
            },
            "required": ["mode"],
            "additionalProperties": false
          },
          "trigger": {
            "type": "object",
            "properties": {
              "delayMs": { "type": "number", "minimum": 0, "maximum": 3600000 },
              "cooldownMs": { "type": "number", "minimum": 0, "maximum": 3600000 },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["delayMs", "cooldownMs", "probability"],
            "additionalProperties": false
          },
          "playback": {
            "type": "object",
            "properties": {
              "volume": { "type": "number", "minimum": 0, "maximum": 4 },
              "bus": { "type": "string", "enum": ["sfx", "music", "voice"] },
              "spatial": { "type": "string", "enum": ["2d", "3d"] },
              "mode": { "type": "string", "enum": ["one-shot", "loop"] },
              "fadeInMs": { "type": "number", "minimum": 0, "maximum": 60000 },
              "fadeOutMs": { "type": "number", "minimum": 0, "maximum": 60000 },
              "stopEventId": { "type": "string" }
            },
            "required": ["volume", "bus", "spatial", "mode", "fadeInMs", "fadeOutMs"],
            "additionalProperties": false
          },
          "shaping": {
            "type": "object",
            "description": "事件级声音感觉；应用到该事件的全部变体",
            "additionalProperties": false,
            "properties": {
              "gainDb": { "type": "number", "minimum": -24, "maximum": 12 },
              "pitchSemitones": { "type": "number", "minimum": -12, "maximum": 12 },
              "highpassHz": { "type": "number", "minimum": 20, "maximum": 2000 },
              "lowpassHz": { "type": "number", "minimum": 1000, "maximum": 20000 },
              "eqLowDb": { "type": "number", "minimum": -12, "maximum": 12 },
              "eqMidDb": { "type": "number", "minimum": -12, "maximum": 12 },
              "eqHighDb": { "type": "number", "minimum": -12, "maximum": 12 }
            }
          },
          "follow": {
            "type": "object",
            "description": "让声音跟随游戏值变化。cases用于不同值切换声音，range用于数值连续改变声音。游戏未提供值时自动使用默认声音。",
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string", "description": "游戏事件上下文或gameAudio.setGameValue登记的变量路径" },
              "label": { "type": "string" },
              "defaultValue": {},
              "cases": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "value": {},
                    "label": { "type": "string" },
                    "assets": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "assetId": { "type": "string" },
                          "file": { "type": "string" },
                          "name": { "type": "string" },
                          "shaping": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "gainDb": { "type": "number", "minimum": -24, "maximum": 12 },
                              "pitchSemitones": { "type": "number", "minimum": -12, "maximum": 12 },
                              "highpassHz": { "type": "number", "minimum": 20, "maximum": 2000 },
                              "lowpassHz": { "type": "number", "minimum": 1000, "maximum": 20000 },
                              "eqLowDb": { "type": "number", "minimum": -12, "maximum": 12 },
                              "eqMidDb": { "type": "number", "minimum": -12, "maximum": 12 },
                              "eqHighDb": { "type": "number", "minimum": -12, "maximum": 12 }
                            }
                          }
                        },
                        "required": ["assetId", "file"]
                      }
                    }
                  },
                  "required": ["value", "assets"]
                }
              },
              "range": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "min": { "type": "number" },
                  "max": { "type": "number" },
                  "volumeStart": { "type": "number", "minimum": 0, "maximum": 4 },
                  "volumeEnd": { "type": "number", "minimum": 0, "maximum": 4 },
                  "pitchStart": { "type": "number", "minimum": -12, "maximum": 12 },
                  "pitchEnd": { "type": "number", "minimum": -12, "maximum": 12 },
                  "lowpassStart": { "type": "number", "minimum": 1000, "maximum": 20000 },
                  "lowpassEnd": { "type": "number", "minimum": 1000, "maximum": 20000 }
                },
                "required": ["min", "max", "volumeStart", "volumeEnd", "pitchStart", "pitchEnd", "lowpassStart", "lowpassEnd"]
              }
            },
            "required": ["field", "defaultValue"],
            "oneOf": [
              { "required": ["cases"], "not": { "required": ["range"] } },
              { "required": ["range"], "not": { "required": ["cases"] } }
            ]
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string" },
                "operator": { "type": "string", "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in"] },
                "value": {}
              },
              "required": ["field", "operator", "value"],
              "additionalProperties": false
            }
          }
        },
        "required": ["eventId", "kind", "assets"],
        "additionalProperties": false
      }
    }
  },
  "required": ["slug", "expectedRevision"],
  "additionalProperties": false
}
