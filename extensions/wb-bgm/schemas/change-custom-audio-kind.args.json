{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forgeax://plugin/wb-bgm/change-custom-audio-kind.args",
  "title": "change-custom-audio-kind args",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "assetId": { "type": "string", "pattern": "^custom:(bgm|sfx):sha256:[a-f0-9]{64}$" },
    "kind": { "type": "string", "enum": ["bgm", "sfx"] }
  },
  "required": ["assetId", "kind"]
}
