{
  "schemaVersion": 2,
  "id": "@forgeax-extension/wb-plugin-author",
  "version": "0.1.0",
  "displayName": {
    "zh": "插件作者",
    "en": "Plugin Author"
  },
  "description": {
    "zh": "插件作者工作台 · 在 Studio 内编辑 .forgeax/extensions/<slug>/ 下的本地插件:左侧文件树 + 右侧文本编辑器,保存即写回并后台热重载注册表;配合 fork / record-as-skill 创建插件。",
    "en": "Plugin Author workbench — an in-app editor for local plugins under .forgeax/extensions/<slug>/: a left file tree + right text editor; saving writes back and hot-reloads the plugin registry in the background. Pairs with fork / record-as-skill to create a plugin."
  },
  "entry": {
    "frontend": "./src/panel.tsx"
  },
  "experimental": true,
  "categories": [
    "workbench"
  ],
  "contributes": {
    "panelTypes": [
      {
        "id": "plugin-author.content",
        "runtime": "inline",
        "entry": "./src/panel.tsx"
      }
    ],
    "pages": [
      {
        "id": "plugin-author",
        "title": {
          "zh": "插件作者",
          "en": "Plugin Author"
        },
        "icon": "Plug",
        "cardinality": "singleton",
        "restorePolicy": "project",
        "layout": {
          "version": 2,
          "root": {
            "kind": "tabs",
            "placements": [
              "content"
            ],
            "active": "content"
          }
        },
        "layoutVersion": 2,
        "panels": [
          {
            "id": "content",
            "panelType": {
              "extension": "self",
              "id": "plugin-author.content"
            }
          }
        ],
        "matchProduces": [
          ".forgeax/extensions/**"
        ]
      }
    ],
    "activities": [
      {
        "id": "plugin-author.launcher",
        "title": {
          "zh": "插件作者",
          "en": "Plugin Author"
        },
        "icon": "Plug",
        "order": 220,
        "category": "general",
        "pageType": {
          "extension": "self",
          "id": "plugin-author"
        }
      }
    ]
  }
}
